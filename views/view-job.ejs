<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/img/grc_logo_green.png" type="image/png">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>View Job | Trades Job Board</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-bg">
        <div class="container-fluid navbar-container d-flex flex-nowrap">
            <a class="navbar-brand d-flex flex-column align-items-center justify-content-start nav-link" href="/">
                <img src="/img/grc_logo_white.png" width="97" alt="GRC Logo">
                Trades Job Board
            </a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/">All Jobs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/add-job">Add Job</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="https://greenriver.edu/students/academics/areas-of-interest/program-maps/trades-industrial-tech-aviation-natural-resources/index.html" target="_blank">GRC Trades Page</a>
                </li>
            </ul>
        </div>
    </nav>
    <div class="container-fluid w-75 mb-4">
        <h1>Job details</h1>
        <h2><%= job.title %></h2>
        <p>Company: <%= job.company %></p>
        <p>Location: <%= job.location %></p>
        <p>Post Date: <%= job.post_date %></p>
        <p>Close Date: <%= job.close_date %></p>
        <p>Trade: <%= job.trade %></p>
        <p>Employment Type: <%= job.type%></p>
        <p>Internship: <%= job.is_internship ? 'Yes' : 'No' %></p>
        <p>Paid: <%= job.is_paid ? 'Yes' : 'No' %></p>
        <% if (job.is_paid === 1) { %>
            <p>Compensation: <%= job.compensation %></p>
        <% } %>
        <p>Description: <%= job.description %></p>
        <% if (job.posting_link) { %>
            <a href="https://<%= job.posting_link %>" target="_blank">Apply on company website</a>
        <% } else { %>
            <p>No external application link submitted.</p>
        <% } %>
    </div>
</body>
</html>